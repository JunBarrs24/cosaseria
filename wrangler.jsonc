{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cosaseria",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-16",

  // Solo se publica public/. La raíz del repositorio queda fuera:
  // README, .gitignore y el código del Worker no son parte del sitio.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Envío nativo de Cloudflare. Enviar a una dirección de destino ya
  // verificada en Email Routing es gratis y no consume cuota, que es
  // exactamente lo que hace el formulario: un aviso interno por mensaje.
  //
  // Sin "allowed_destination_addresses" a propósito: este repositorio es
  // público y ahí acabaría una dirección personal. El destino vive en la
  // variable CORREO_DESTINO, en el panel.
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Conteo del rate limit por IP. El binding debe llamarse LIMITES: es el
  // nombre que busca src/contacto.js, y si no coincide la función registra
  // un aviso y deja pasar todas las peticiones.
  //
  // Sin "preview_id": wrangler dev simula KV en local. Solo haría falta
  // para `wrangler dev --remote`, y entonces hay que crear un segundo
  // namespace con `wrangler kv namespace create LIMITES --preview`.
  "kv_namespaces": [
    {
      "binding": "LIMITES",
      "id": "b2a119572c5b43b896fd70c697d5ecd9"
    }
  ],

  // Con un archivo de configuración presente, este archivo manda: un
  // `wrangler deploy` borra las variables sueltas que se hayan puesto en
  // el panel. Por eso lo que no es secreto vive aquí, y lo que sí lo es
  // se sube como secreto, que es lo único que el deploy no toca.
  "vars": {
    "CORREO_ORIGEN": "sitio@cosaseria.mx"
  },

  "observability": {
    "enabled": true
  }

  // Como secretos, nunca en el repositorio ni como variables del panel:
  //   wrangler secret put FIRMA_SECRETO
  //   wrangler secret put CORREO_DESTINO
  //
  // Pendiente en el panel:
  //   Regla de Rate Limiting del WAF sobre /api/contacto
}
